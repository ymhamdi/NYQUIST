---
import Report from '../../../components/ts-tp3/Report.svelte'
import { TP } from '../../../content/tsTp3'
import Base from '../../../layouts/Base.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<Base
  title={`Compte rendu — TP${TP.number}`}
  description="Compte rendu imprimable du TP3 de traitement du signal (transformée de Fourier discrète) : questions, calculs, figures et script MATLAB avec les valeurs choisies."
  section="rapport"
>
  <div class="wrap">
    <Report client:load errataBase={`${base}errata/`} tpHref={`${base}signal/tp3/`} />
  </div>
</Base>
