---
import Report from '../../../components/ts-tp4/Report.svelte'
import { TP } from '../../../content/tsTp4'
import Base from '../../../layouts/Base.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<Base
  title={`Compte rendu — TP${TP.number}`}
  description="Compte rendu imprimable du TP4 de traitement du signal (analyse des filtres numériques) : questions, calculs, figures et script MATLAB avec les valeurs choisies."
  section="rapport"
>
  <div class="wrap">
    <Report client:load errataBase={`${base}errata/`} tpHref={`${base}signal/tp4/`} />
  </div>
</Base>
