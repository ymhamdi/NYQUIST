---
import PartIII from '../../components/ae-tp4/PartIII.svelte'
import PartIIIb from '../../components/ae-tp4/PartIIIb.svelte'
import PartIV from '../../components/ae-tp4/PartIV.svelte'
import { PART_III, PART_IV, TP } from '../../content/aeTp4'
import TpLayout from '../../layouts/TpLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const errataBase = `${base}errata/`
---

<TpLayout
  tp={TP}
  description="Régulation PID du niveau d'un réservoir et de la vitesse d'un moteur à courant continu : effet de kp, ki et kd, stepinfo avant et après. Calculs, figures et code MATLAB qui suivent les curseurs."
  parts={[{ id: 'III', questions: PART_III.questions }, { id: 'IV', questions: PART_IV.questions }]}
  reportPath="rapport/automatique/tp4/"
  dsPath="ds/automatique/"
>
  <PartIII client:idle errataBase={errataBase} />
  <PartIIIb client:visible errataBase={errataBase} />
  <PartIV client:visible errataBase={errataBase} />
</TpLayout>
