---
import PartII from '../../components/ae-tp3/PartII.svelte'
import PartIII from '../../components/ae-tp3/PartIII.svelte'
import { PART_II, PART_III, TP } from '../../content/aeTp3'
import TpLayout from '../../layouts/TpLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const errataBase = `${base}errata/`
---

<TpLayout
  tp={TP}
  description="Stabilité et précision d'un système échantillonné asservi : transformée en z avec bloqueur, pôles, valeur limite du gain, réservoir d'eau. Calculs, figures et code MATLAB qui suivent les curseurs."
  parts={[{ id: 'II', questions: PART_II.questions }, { id: 'III', questions: PART_III.questions }]}
  reportPath="rapport/automatique/tp3/"
  dsPath="ds/automatique/"
>
  <PartII client:idle errataBase={errataBase} />
  <PartIII client:visible errataBase={errataBase} />
</TpLayout>
