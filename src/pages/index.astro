---
import '@fontsource/ibm-plex-mono/latin-400.css'
import { COURSES } from '../content/courses'
import Base from '../layouts/Base.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<Base title="Accueil" description="Travaux pratiques MATLAB d'automatique échantillonnée et de traitement du signal (INSAT, IIA 3), interactifs et vérifiés." section="home">
  <section class="hero" aria-labelledby="hero-title">
    <script is:inline>
      // palette variant for the review (?palette=b), before the first paint
      try {
        const p = new URLSearchParams(location.search).get('palette')
        if (p === 'a' || p === 'b') document.currentScript.parentElement.dataset.palette = p
      } catch {}
    </script>
    <canvas class="scene" aria-hidden="true"></canvas>
    <div class="hero-text">
      <p class="kicker">INSAT · IIA 3 · TP MATLAB</p>
      <h1 id="hero-title">Nyquist</h1>
      <p class="lead">
        Les TP de traitement du signal et d'automatique échantillonnée, question par question : prédiction, calcul à la main, figures et code MATLAB qui
        suivent les curseurs, compte rendu imprimable.
      </p>
      <div class="cta">
        <a class="btn" href="#cours">Choisir un TP</a>
        <a class="btn ghost" href={`${base}ds/automatique/`}>Mode DS</a>
      </div>
      <ul class="legend" aria-label="Lecture de l'animation">
        <li><span class="sw cyan"></span>signal continu</li>
        <li><span class="sw amber"></span>échantillons</li>
        <li><span class="sw zoh"></span>bloqueur, quantification</li>
        <li><span class="sw magenta"></span>repliement</li>
        <li><span class="sw red"></span>instabilité</li>
      </ul>
      <p class="hint">Déplacez le pointeur : horizontalement il règle Fe, verticalement le gain K. Un clic envoie une impulsion δ[n].</p>
    </div>
    <button class="motion" type="button" aria-pressed="false">Pause animation</button>
  </section>

  <div class="wrap" id="cours">
    <div class="courses">
      {
        COURSES.map((c) => (
          <section class="card" aria-labelledby={`c-${c.id}`}>
            <h2 id={`c-${c.id}`}>{c.name}</h2>
            <ul>
              {c.tps.map((t) => (
                <li>
                  {t.path ? <a href={`${base}${t.path}`}>TP{t.n} : {t.title}</a> : <span>TP{t.n} : {t.title}</span>}
                  <span class="tag">{t.status}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="muted">
      Chaque valeur affichée est calculée par le moteur du site. Ce moteur est testé contre GNU Octave, qui exécute les scripts MATLAB du TP à chaque
      modification, y compris pour des positions de curseurs tirées au hasard. Les incohérences du fascicule sont listées dans l'<a href={`${base}errata/`}
        >errata</a
      >.
    </p>
  </div>
</Base>

<script>
  import { mountScene, type Scene } from '../scene/chain'

  const hero = document.querySelector<HTMLElement>('.hero')!
  const canvas = hero.querySelector('canvas')!
  const btn = hero.querySelector<HTMLButtonElement>('.motion')!
  const KEY = 'nyq-motion'
  let stored: string | null = null
  try {
    stored = localStorage.getItem(KEY)
  } catch {
    /* storage unavailable */
  }
  let paused = stored ? stored === 'paused' : matchMedia('(prefers-reduced-motion: reduce)').matches
  let scene: Scene | null = null
  const label = () => {
    btn.setAttribute('aria-pressed', String(paused))
    btn.textContent = paused ? 'Reprendre l’animation' : 'Pause animation'
  }
  label()
  btn.addEventListener('click', () => {
    paused = !paused
    label()
    scene?.setPaused(paused)
    try {
      localStorage.setItem(KEY, paused ? 'paused' : 'playing')
    } catch {
      /* not remembered */
    }
  })
  // after the first paint, once the label font is there
  const start = () => {
    const go = () => {
      scene = mountScene(canvas, { paused })
      new MutationObserver(() => scene?.refreshColors()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => scene?.refreshColors())
    }
    document.fonts.load('11px "IBM Plex Mono"').then(go, go)
  }
  const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 200))
  if (document.readyState === 'complete') idle(start)
  else addEventListener('load', () => idle(start), { once: true })
</script>

<style>
  /* ---- palettes of the scene: A (ink blue), B (Prussian blue); light = the same on graph paper ---- */
  .hero {
    --s-bg: #fbfcff;
    --s-grid: rgb(30 80 200 / 0.07);
    --s-grid-major: rgb(30 80 200 / 0.15);
    --s-cyan: #0071b0;
    --s-amber: #b25a00;
    --s-zoh: #1b2233;
    --s-magenta: #b3168f;
    --s-red: #c62828;
    --s-ink: #0c1a33;
    --s-ink-soft: #4a5a78;
    --s-panel: rgb(251 252 255 / 0.86);
    --s-scrim: rgb(251 252 255 / 0.84);
  }
  .hero[data-palette='b'] {
    --s-bg: #fdfbf5;
    --s-grid: rgb(20 110 120 / 0.08);
    --s-grid-major: rgb(20 110 120 / 0.16);
    --s-cyan: #00737c;
    --s-amber: #9c5d06;
    --s-zoh: #2b2925;
    --s-magenta: #9b2f92;
    --s-red: #ad2a20;
    --s-ink: #1d282e;
    --s-ink-soft: #52626a;
    --s-panel: rgb(253 251 245 / 0.88);
    --s-scrim: rgb(253 251 245 / 0.86);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hero {
      --s-bg: #0a1633;
      --s-grid: rgb(120 160 255 / 0.06);
      --s-grid-major: rgb(120 160 255 / 0.13);
      --s-cyan: #4fd2ff;
      --s-amber: #ffad2e;
      --s-zoh: #eef2fa;
      --s-magenta: #ff52d9;
      --s-red: #ff5c5c;
      --s-ink: #eef2fb;
      --s-ink-soft: #a3b3d2;
      --s-panel: rgb(10 22 51 / 0.78);
      --s-scrim: rgb(10 22 51 / 0.8);
    }
    :global(:root:not([data-theme='light'])) .hero[data-palette='b'] {
      --s-bg: #0f1e2b;
      --s-grid: rgb(160 205 220 / 0.05);
      --s-grid-major: rgb(160 205 220 / 0.11);
      --s-cyan: #7ee2dc;
      --s-amber: #f0c36a;
      --s-zoh: #f5efe4;
      --s-magenta: #e47cd9;
      --s-red: #f2766b;
      --s-ink: #eef3f5;
      --s-ink-soft: #a6b8c3;
      --s-panel: rgb(15 30 43 / 0.8);
      --s-scrim: rgb(15 30 43 / 0.82);
    }
  }
  :global(:root[data-theme='dark']) .hero {
    --s-bg: #0a1633;
    --s-grid: rgb(120 160 255 / 0.06);
    --s-grid-major: rgb(120 160 255 / 0.13);
    --s-cyan: #4fd2ff;
    --s-amber: #ffad2e;
    --s-zoh: #eef2fa;
    --s-magenta: #ff52d9;
    --s-red: #ff5c5c;
    --s-ink: #eef2fb;
    --s-ink-soft: #a3b3d2;
    --s-panel: rgb(10 22 51 / 0.78);
    --s-scrim: rgb(10 22 51 / 0.8);
  }
  :global(:root[data-theme='dark']) .hero[data-palette='b'] {
    --s-bg: #0f1e2b;
    --s-grid: rgb(160 205 220 / 0.05);
    --s-grid-major: rgb(160 205 220 / 0.11);
    --s-cyan: #7ee2dc;
    --s-amber: #f0c36a;
    --s-zoh: #f5efe4;
    --s-magenta: #e47cd9;
    --s-red: #f2766b;
    --s-ink: #eef3f5;
    --s-ink-soft: #a6b8c3;
    --s-panel: rgb(15 30 43 / 0.8);
    --s-scrim: rgb(15 30 43 / 0.82);
  }

  .hero {
    position: relative;
    min-height: max(34rem, calc(100svh - 3.6rem));
    overflow: hidden;
    color: var(--s-ink);
    /* the paper shows before the canvas starts, and without JavaScript */
    background-color: var(--s-bg);
    background-image:
      linear-gradient(var(--s-grid-major) 1px, transparent 1px), linear-gradient(90deg, var(--s-grid-major) 1px, transparent 1px),
      linear-gradient(var(--s-grid) 1px, transparent 1px), linear-gradient(90deg, var(--s-grid) 1px, transparent 1px);
    background-size:
      40px 40px,
      40px 40px,
      8px 8px,
      8px 8px;
    touch-action: pan-y;
  }
  .scene {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-text {
    position: relative;
    max-width: 36rem;
    margin: clamp(1rem, 4vh, 2.5rem) clamp(1rem, 4vw, 3rem) 0;
    padding: 1.1rem 1.3rem 1rem;
    border-radius: 10px;
    background: var(--s-scrim);
  }
  .kicker,
  .legend,
  .hint,
  .motion {
    font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace;
  }
  .kicker {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--s-ink-soft);
  }
  h1 {
    margin: 0.2rem 0 0.4rem;
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    line-height: 1;
    color: var(--s-ink);
  }
  .lead {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    color: var(--s-ink);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-size: 0.74rem;
    color: var(--s-ink-soft);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sw {
    width: 0.9rem;
    height: 3px;
    border-radius: 2px;
  }
  .sw.cyan {
    background: var(--s-cyan);
  }
  .sw.amber {
    background: var(--s-amber);
  }
  .sw.zoh {
    background: var(--s-zoh);
  }
  .sw.magenta {
    background: var(--s-magenta);
  }
  .sw.red {
    background: var(--s-red);
  }
  .hint {
    margin: 0.6rem 0 0;
    font-size: 0.74rem;
    color: var(--s-ink-soft);
  }
  @media (pointer: coarse) {
    .hint {
      display: none;
    }
  }
  .motion {
    position: absolute;
    top: 1rem;
    right: clamp(1rem, 3vw, 2rem);
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--s-ink-soft);
    border-radius: 6px;
    background: var(--s-scrim);
    color: var(--s-ink);
    font-size: 0.8rem;
    cursor: pointer;
  }
  @media (max-width: 40rem) {
    /* phone: the toggle sits above the text, out of the chain and the z-plane */
    .motion {
      top: 0.6rem;
      right: 1rem;
    }
    .hero-text {
      margin-top: 3.6rem;
    }
    .lead {
      font-size: 0.95rem;
    }
    /* the scene goes on below the text: chain, spectrum, then the loop panels (scrolling also raises K) */
    .hero {
      min-height: 48rem;
    }
  }

  .courses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem;
    margin: 2rem 0 1.5rem;
  }
  .courses h2 {
    margin-top: 0;
    border: 0;
    padding: 0;
    font-size: 1.3rem;
  }
  .courses ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .courses li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    align-items: center;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .courses li a,
  .courses li span:first-child {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
</style>
