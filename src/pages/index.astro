---
import CourseCard from '../components/CourseCard.astro'
import SceneHero from '../components/SceneHero.astro'
import { COURSES } from '../content/courses'
import Base from '../layouts/Base.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<Base title="Accueil" description="Travaux pratiques MATLAB d'automatique échantillonnée et de traitement du signal (INSAT, IIA 3), interactifs et vérifiés." section="home">
  <SceneHero labelledby="hero-title">
    <p class="kicker">INSAT · IIA 3 · TP MATLAB</p>
    <h1 id="hero-title">Nyquist</h1>
    <p class="lead">
      Les TP de traitement du signal et d'automatique échantillonnée, question par question : prédiction, calcul à la main, figures et code MATLAB qui
      suivent les curseurs, compte rendu imprimable.
    </p>
    <div class="cta">
      <a class="btn" href="#cours">Choisir un TP</a>
      <a class="btn ghost" href={`${base}ds/automatique/`}>Mode DS</a>
    </div>
    <ul class="legend mono" aria-label="Lecture de l'animation">
      <li><span class="sw cyan"></span>signal continu</li>
      <li><span class="sw amber"></span>échantillons</li>
      <li><span class="sw zoh"></span>bloqueur, quantification</li>
      <li><span class="sw magenta"></span>repliement</li>
      <li><span class="sw red"></span>instabilité</li>
    </ul>
    <p class="hint mono">Déplacez le pointeur : horizontalement il règle Fe, verticalement le gain K. Un clic envoie une impulsion δ[n].</p>
  </SceneHero>

  <section class="bench below" id="cours" aria-labelledby="cours-title">
    <div class="wrap">
      <h2 id="cours-title">Les cours</h2>
      <div class="courses">
        {COURSES.map((c) => <CourseCard course={c} />)}
      </div>
      <p class="muted foot">
        Chaque valeur affichée est calculée par le moteur du site. Ce moteur est testé contre GNU Octave, qui exécute les scripts MATLAB du TP à chaque
        modification, y compris pour des positions de curseurs tirées au hasard. Les incohérences du fascicule sont listées dans l'<a href={`${base}errata/`}
          >errata</a
        >.
      </p>
    </div>
  </section>
</Base>

<style>
  h1 {
    margin: 0.2rem 0 0.4rem;
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    line-height: 1;
    color: var(--s-ink);
  }
  .lead {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    color: var(--s-ink);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-size: 0.74rem;
    color: var(--s-ink-soft);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sw {
    width: 0.9rem;
    height: 3px;
    border-radius: 2px;
  }
  .sw.cyan {
    background: var(--s-cyan);
  }
  .sw.amber {
    background: var(--s-amber);
  }
  .sw.zoh {
    background: var(--s-zoh);
  }
  .sw.magenta {
    background: var(--s-magenta);
  }
  .sw.red {
    background: var(--s-red);
  }
  .hint {
    margin: 0.6rem 0 0;
    font-size: 0.74rem;
    color: var(--s-ink-soft);
  }
  @media (pointer: coarse) {
    .hint {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .lead {
      font-size: 0.95rem;
    }
  }
  .below {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--s-rule);
  }
  .below h2 {
    margin-top: 0;
    border: 0;
    padding: 0;
    color: var(--s-ink);
  }
  .courses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1.2rem;
    margin: 1rem 0 1.5rem;
  }
  .foot {
    max-width: 46rem;
  }
</style>
