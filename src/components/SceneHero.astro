---
/**
 * Full-width hero with the live sampling chain behind its text (slot).
 * `calm`: course pages, lower opacity and no z-plane.
 */
import '@fontsource/ibm-plex-mono/latin-400.css'
import '../styles/scene.css'

interface Props {
  calm?: boolean
  labelledby: string
}
const { calm = false, labelledby } = Astro.props
---

<section class:list={['hero', 'bench', { calm }]} data-calm={String(calm)} aria-labelledby={labelledby}>
  <canvas class="scene" aria-hidden="true"></canvas>
  <div class="hero-text">
    <slot />
  </div>
  <button class="motion mono" type="button" aria-pressed="false">Pause animation</button>
</section>

<script>
  import { startHero } from '../scene/start'

  for (const hero of document.querySelectorAll<HTMLElement>('.hero')) startHero(hero)
</script>

<style>
  .hero {
    position: relative;
    min-height: max(34rem, calc(100svh - 3.6rem));
    overflow: hidden;
    touch-action: pan-y;
  }
  .hero.calm {
    min-height: 38rem; /* text, then the chain and its spectrum below it */
  }
  .scene {
    position: absolute;
    inset: 0;
    display: block;
  }
  .calm .scene {
    opacity: 0.55;
  }
  .hero-text {
    position: relative;
    max-width: 36rem;
    margin: clamp(1rem, 4vh, 2.5rem) clamp(1rem, 4vw, 3rem) 0;
    padding: 1.1rem 1.3rem 1rem;
    border-radius: 10px;
    background: var(--s-scrim);
  }
  .motion {
    position: absolute;
    top: 1rem;
    right: clamp(1rem, 3vw, 2rem);
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--s-ink-soft);
    border-radius: 6px;
    background: var(--s-scrim);
    color: var(--s-ink);
    font-size: 0.8rem;
    cursor: pointer;
  }
  @media (max-width: 40rem) {
    .motion {
      top: 0.6rem;
      right: 1rem;
    }
    .hero-text {
      margin-top: 3.6rem;
    }
    .hero:not(.calm) {
      min-height: 48rem;
    }
  }
</style>
