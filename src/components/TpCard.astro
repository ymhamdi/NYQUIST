---
/** One TP as a card: its glyph (drawn from the TP's main concept), number, title, status, links. */
import type { Course, TpEntry } from '../content/courses'
import { TP_GLYPHS } from '../scene/glyphs'
import Glyph from './Glyph.astro'

interface Props {
  course: Course
  tp: TpEntry
}
const { course, tp } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const make = TP_GLYPHS[`${course.id}-${tp.n}`]
const g = make ? make() : null
---

<article class:list={['tp-card', 'card-anim', { off: !tp.path }]}>
  {g && <div class="art"><Glyph g={g} /></div>}
  <p class="kicker">TP{tp.n}</p>
  <h3>{tp.path ? <a class="stretch" href={`${base}${tp.path}`}>{tp.title}</a> : tp.title}</h3>
  <p class="status mono">{tp.status}</p>
  {tp.path && <a class="report mono" href={`${base}rapport/${tp.path}`}>Compte rendu</a>}
</article>

<style>
  .tp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid var(--s-rule);
    border-radius: 10px;
    background: var(--s-card);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .tp-card:is(:hover, :focus-within) {
    border-color: var(--s-accent);
    transform: translateY(-2px);
  }
  .tp-card.off {
    opacity: 0.85;
  }
  .art {
    margin: 0 0 0.6rem;
    padding: 0.4rem;
    border-radius: 6px;
    background: var(--s-bg);
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--s-ink);
  }
  .stretch {
    color: inherit;
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }
  .stretch:focus-visible {
    outline: none;
  }
  .stretch:focus-visible::after {
    outline: 3px solid var(--s-accent);
    outline-offset: 2px;
  }
  .status {
    margin: 0.2rem 0 0;
    font-size: 0.74rem;
    color: var(--s-ink-soft);
  }
  .report {
    position: relative; /* above the stretched link */
    align-self: flex-start;
    margin-top: 0.4rem;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .tp-card {
      transition: none;
    }
    .tp-card:is(:hover, :focus-within) {
      transform: none;
    }
  }
</style>
