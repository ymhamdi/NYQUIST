---
/**
 * A course on the landing page. Traitement du signal: a sine turning into
 * its samples; Automatique: a step response settling in the ±5 % band of
 * its setpoint (both computed by the engine at build time).
 */
import type { Course } from '../content/courses'
import { courseAuto, courseSignal } from '../scene/glyphs'
import Glyph from './Glyph.astro'

interface Props {
  course: Course
}
const { course } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const g = course.id === 'signal' ? courseSignal() : courseAuto()
const ready = course.tps.filter((t) => t.path)
---

<article class="course-card card-anim">
  <div class="art"><Glyph g={g} w={200} h={90} fadeWave={course.id === 'signal'} /></div>
  <h3><a class="stretch" href={`${base}${course.id}/`}>{course.name}</a></h3>
  <p class="blurb">{course.blurb}</p>
  <ul class="chips" aria-label={`TP de ${course.name}`}>
    {
      course.tps.map((t) => (
        <li>
          {t.path ? (
            <a class="chip mono" href={`${base}${t.path}`} title={t.title}>
              TP{t.n}
            </a>
          ) : (
            <span class="chip off mono" title={`${t.title} : ${t.status}`}>
              TP{t.n}
            </span>
          )}
        </li>
      ))
    }
  </ul>
  <p class="count mono">{ready.length} page{ready.length > 1 ? 's' : ''} interactive{ready.length > 1 ? 's' : ''} sur {course.tps.length} TP</p>
</article>

<style>
  .course-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem;
    border: 1px solid var(--s-rule);
    border-radius: 12px;
    background: var(--s-card);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .course-card:is(:hover, :focus-within) {
    border-color: var(--s-accent);
    transform: translateY(-2px);
  }
  .art {
    margin-bottom: 0.4rem;
    padding: 0.6rem;
    border-radius: 8px;
    background: var(--s-bg);
  }
  h3 {
    margin: 0;
    font-size: 1.3rem;
    color: var(--s-ink);
  }
  .stretch {
    color: inherit;
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }
  .stretch:focus-visible {
    outline: none;
  }
  .stretch:focus-visible::after {
    outline: 3px solid var(--s-accent);
    outline-offset: 2px;
  }
  .blurb {
    margin: 0;
    color: var(--s-ink-soft);
  }
  .chips {
    position: relative; /* above the stretched link */
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    border: 1px solid var(--s-rule);
    border-radius: 6px;
    font-size: 0.85rem;
  }
  .chip.off {
    color: var(--s-ink-soft);
    border-style: dashed;
  }
  .count {
    margin: 0.2rem 0 0;
    font-size: 0.74rem;
    color: var(--s-ink-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .course-card {
      transition: none;
    }
    .course-card:is(:hover, :focus-within) {
      transform: none;
    }
  }
</style>
